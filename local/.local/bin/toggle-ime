#!/bin/bash
# Toggle between Vietnamese (ibus-bamboo) and English input.
# Switches the active ibus engine instantly — no daemon restart.
export IBUS_COMPONENT_PATH="$HOME/.local/share/ibus/component:/usr/share/ibus/component"
export PATH="/usr/bin:/bin:$HOME/.local/bin"

# Make sure both engines are available to switch between (idempotent, persisted).
gsettings set org.freedesktop.ibus.general preload-engines "['xkb:us::eng', 'Bamboo']" 2>/dev/null

current=$(timeout 2 ibus engine 2>/dev/null)
if [ "$current" = "Bamboo" ]; then
  timeout 3 ibus engine xkb:us::eng
else
  timeout 3 ibus engine Bamboo
fi
